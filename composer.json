{
    "name": "ernestdefoe/opensearch",
    "description": "OpenSearch (and Elasticsearch) search for Flarum 2 — a drop-in search driver with optional semantic search.",
    "keywords": ["flarum", "search", "opensearch", "elasticsearch", "fulltext", "semantic"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39756-open-search-built-with-ai",
        "issues": "https://github.com/ernestdefoe/opensearch/issues",
        "source": "https://github.com/ernestdefoe/opensearch"
    },
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\OpenSearch\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "OpenSearch",
            "category": "feature",
            "icon": {
                "name": "fas fa-magnifying-glass-chart",
                "backgroundColor": "#005EB8",
                "color": "#fff"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
